        ];

        coreTemplates.forEach(t => {
            allQuizQuestions.push({ q: t.q, a: t.a, opts: [t.a, t.fp, t.a === "to" ? "at" : "to", "in"], reason: t.reason });
        });

        // 80 dynamic questions
        const subjects = ["The teacher", "John", "Mary", "The driver", "My boss", "The dog", "The soldier", "Someone", "Nobody", "The pilot"];
        const verbsDest = ["went", "traveled", "flew", "drove", "walked", "ran", "moved", "relocated"];
        const verbsDir = ["pointed", "looked", "turned", "headed", "glanced", "gestured", "stared", "nodded"];
