            document.getElementById('quiz-progress-bar').style.width = `${((currentQIndex + 1) / 10) * 100}%`;
            
            let displayQ = qObj.q.replace("___", "______");
            document.getElementById('question-text').innerText = displayQ;
            
            const optsContainer = document.getElementById('options-container');
            optsContainer.innerHTML = '';
            
            const uniqueOpts = [...new Set(qObj.opts)];
            const shuffledOpts = shuffleArray(uniqueOpts);
            
            shuffledOpts.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "quiz-option-btn w-full py-4 bg-[#111A2C] border border-white/10 hover:bg-white/10 text-white rounded-xl transition font-semibold text-lg uppercase tracking-wide";
                btn.innerText = opt;
                btn.onclick = () => selectAnswer(btn, opt, qObj);
                optsContainer.appendChild(btn);
            });
        }

        function selectAnswer(btn, selected, qObj) {
            const btns = document.querySelectorAll('.quiz-option-btn');
            btns.forEach(b => {
                b.disabled = true;
                b.classList.remove('hover:bg-white/10');
            });

            const isCorrect = selected === qObj.a;
            if (isCorrect) {
                btn.classList.add('bg-green-600', 'border-green-400');
                btn.classList.remove('bg-[#111A2C]');
                score++;
            } else {
                btn.classList.add('bg-red-600', 'border-red-400');
                btn.classList.remove('bg-[#111A2C]');
                btns.forEach(b => {
                    if(b.innerText.toLowerCase() === qObj.a.toLowerCase()) {
                        b.classList.add('bg-green-600', 'border-green-400');
                        b.classList.remove('bg-[#111A2C]');
